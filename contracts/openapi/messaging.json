    "/v1/messages/threads": {
      "post": {
        "operationId": "requestMessageThread",
        "description": "Gửi lời mời nhắn tin tới một người trong danh sách people. Lời mời không mang chữ nào. Người ngoài danh sách (kể cả người đã chặn) là 404. Đã có hội thoại đang mời hoặc đang mở, hoặc chưa được phép mời lại: 409 INVALID_TRANSITION kèm resource_id. Tối đa 10 lời mời đang chờ (429).",
        "parameters": [
          {
            "$ref": "#/components/parameters/Workspace"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
