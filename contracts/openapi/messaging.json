          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/ops/messages/reports": {
      "get": {
        "operationId": "listMessageReports",
        "description": "Vai WORKSPACE_ADMIN: các báo cáo trong 30 ngày, số báo cáo theo người bị báo cáo và mã quyền messaging.use đang hiệu lực của họ. Tạm ngừng một người là POST /v1/grants/{grant_id}/revoke.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Workspace"
          }
        ],
        "responses": {
          "200": {
            "description": "Báo cáo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MsgOpsReports"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "MsgThreadId": {
        "name": "thread_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^th_[A-Za-z0-9_-]{6,64}$"
        }
      },
      "MsgEndpointId": {
        "name": "endpoint_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^mep_[A-Za-z0-9_-]{6,64}$"
        }
      }
    },
    "schemas": {
      "MsgEndpointCreate": {
        "type": "object",
        "description": "Không có tên máy, user agent hay mô tả tự do: loại máy là một trong năm giá trị do người dùng chọn.",
        "additionalProperties": false,
        "required": [
          "public_key",
          "kind"
        ],
        "properties": {
          "public_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{87}$",
            "description": "Khóa công khai P-256, điểm không nén 65 byte (0x04 ‖ X ‖ Y), base64url không padding."
          },
          "kind": {
            "enum": [
              "PHONE",
              "TABLET",
              "LAPTOP",
              "DESKTOP",
              "OTHER"
            ]
          }
        }
      },
      "MsgEndpoint": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "endpoint_id",
          "kind",
          "key_id",
          "status",
          "created_at",
          "revoked_at"
        ],
        "properties": {
          "endpoint_id": {
            "type": "string",
            "pattern": "^mep_[A-Za-z0-9_-]{6,64}$"
          },
          "kind": {
            "enum": [
              "PHONE",
              "TABLET",
              "LAPTOP",
              "DESKTOP",
              "OTHER"
            ]
          },
          "key_id": {
            "$ref": "#/components/schemas/Digest"
          },
          "status": {
            "enum": [
              "ACTIVE",
              "REVOKED"
            ]
          },
          "created_at": {
            "$ref": "#/components/schemas/UtcTime"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "MsgEndpointList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "endpoints",
          "limit"
        ],
        "properties": {
          "endpoints": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MsgEndpoint"
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "MsgPeople": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "people"
        ],
        "properties": {
          "people": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "user_id",
                "name"
              ],
              "properties": {
                "user_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:@-]{1,128}$"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "MsgThreadCreate": {
        "type": "object",
        "description": "Chỉ có mã người được mời; lời mời không mang chữ.",
        "additionalProperties": false,
        "required": [
          "peer"
        ],
        "properties": {
          "peer": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:@-]{1,128}$"
          }
        }
      },
      "MsgThread": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "thread_id",
          "state",
          "peer",
          "role",
          "can_request",
          "key_set",
          "last_seq",
          "delivered_seq",
          "read_seq",
          "peer_delivered_seq",
          "peer_read_seq",
          "created_at"
        ],
        "properties": {
          "thread_id": {
            "type": "string",
            "pattern": "^th_[A-Za-z0-9_-]{6,64}$"
          },
          "state": {
            "enum": [
              "THREAD_REQUESTED",
              "THREAD_ACTIVE",
              "THREAD_CLOSED",
              "THREAD_BLOCKED"
            ],
            "description": "Trạng thái người gọi được thấy. THREAD_BLOCKED chỉ hiện với người đã chặn; người bị chặn thấy THREAD_CLOSED."
          },
          "peer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "user_id",
              "name"
            ],
            "properties": {
              "user_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:@-]{1,128}$"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "role": {
            "enum": [
              "REQUESTER",
              "ADDRESSEE"
            ],
            "description": "Vai của người gọi với lời mời gần nhất."
          },
          "can_request": {
            "type": "boolean",
            "description": "Người gọi được gửi lời mời mới cho hội thoại đã đóng này."
          },
          "key_set": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "description": "Mã băm tập khóa hiện hành khi người gọi gửi được tới người kia ngay lúc này (cùng giá trị với GET …/keys); null khi không gửi được. Chỉ là gợi ý để thiết bị biết tập khóa đã đổi: thiết bị lấy lại khóa và tự tính lại mã băm trước khi dùng."
          },
          "last_seq": {
            "type": "integer",
            "minimum": 0
          },
          "delivered_seq": {
            "type": "integer",
            "minimum": 0,
            "description": "Tin của người kia đã được một thiết bị của người gọi xác nhận lưu, liên tục tới số này."
          },
          "read_seq": {
            "type": "integer",
            "minimum": 0
          },
          "peer_delivered_seq": {
            "type": "integer",
            "minimum": 0,
            "description": "Bằng chứng «đã tới thiết bị» cho tin của người gọi."
          },
          "peer_read_seq": {
            "type": "integer",
            "minimum": 0,
            "description": "Bằng chứng «đã xem»: chỉ tăng khi người kia bật chia sẻ."
          },
          "created_at": {
            "$ref": "#/components/schemas/UtcTime"
          }
        }
      },
      "MsgThreadKeys": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "thread_id",
          "endpoints",
          "key_set"
        ],
        "properties": {
          "thread_id": {
            "type": "string",
            "pattern": "^th_[A-Za-z0-9_-]{6,64}$"
          },
          "endpoints": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "endpoint_id",
                "public_key",
                "user_id"
              ],
              "properties": {
                "endpoint_id": {
                  "type": "string",
                  "pattern": "^mep_[A-Za-z0-9_-]{6,64}$"
                },
                "public_key": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{87}$",
                  "description": "Khóa công khai P-256, điểm không nén 65 byte (0x04 ‖ X ‖ Y), base64url không padding."
                },
                "user_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:@-]{1,128}$"
                }
              }
            }
          },
          "key_set": {
            "$ref": "#/components/schemas/Digest"
          }
        }
      },
      "MsgEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "endpoint_id",
          "enc",
          "wrapped"
        ],
        "properties": {
          "endpoint_id": {
            "type": "string",
            "pattern": "^mep_[A-Za-z0-9_-]{6,64}$"
          },
          "enc": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{87}$",
            "description": "Khóa tạm của HPKE, 65 byte."
          },
          "wrapped": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{64}$",
            "description": "Khóa nội dung đã niêm phong, 48 byte."
          }
        }
      },
      "MsgSend": {
        "type": "object",
        "description": "Thân của LNH-MSG-1 (web/shared/msg-crypto.js, fixture contracts/fixtures/msg/lnh-msg-1.json). Không có trường nào mang chữ đọc được; mọi trường lạ bị từ chối.",
        "additionalProperties": false,
        "required": [
          "client_ref",
          "sender_endpoint",
          "key_set",
          "iv",
          "ct",
          "envelopes"
        ],
        "properties": {
          "client_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{22,64}$",
            "description": "Mã do thiết bị đặt, duy nhất cho mỗi tin của thiết bị đó; giữ nguyên khi niêm phong lại."
          },
          "sender_endpoint": {
            "type": "string",
            "pattern": "^mep_[A-Za-z0-9_-]{6,64}$"
          },
          "key_set": {
            "$ref": "#/components/schemas/Digest"
          },
          "iv": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16}$"
          },
          "ct": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{363,16064}$",
            "description": "Bản mã AES-256-GCM kèm thẻ 16 byte; phần đã đệm là bội số của 256 byte, tối đa 12.032 byte."
          },
          "envelopes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "$ref": "#/components/schemas/MsgEnvelope"
            }
          }
        }
      },
      "MsgSent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message_id",
          "seq",
          "sent_at"
        ],
        "properties": {
          "message_id": {
            "type": "string",
            "pattern": "^msg_[A-Za-z0-9_-]{6,64}$"
          },
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "sent_at": {
            "$ref": "#/components/schemas/UtcTime"
          }
        }
      },
      "MsgInboxMessage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message_id",
          "thread_id",
          "seq",
          "sender_user",
          "sender_endpoint",
          "client_ref",
          "iv",
          "ct",
          "enc",
          "wrapped",
          "sent_at"
        ],
        "properties": {
          "message_id": {
            "type": "string",
            "pattern": "^msg_[A-Za-z0-9_-]{6,64}$"
          },
          "thread_id": {
            "type": "string",
            "pattern": "^th_[A-Za-z0-9_-]{6,64}$"
          },
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "sender_user": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:@-]{1,128}$"
          },
          "sender_endpoint": {
            "type": "string",
            "pattern": "^mep_[A-Za-z0-9_-]{6,64}$"
          },
          "client_ref": {
            "type": "string"
          },
          "iv": {
            "type": "string"
          },
          "ct": {
            "type": "string"
          },
          "enc": {
            "type": "string"
          },
          "wrapped": {
            "type": "string"
          },
          "sent_at": {
            "$ref": "#/components/schemas/UtcTime"
          }
        }
      },
      "MsgInbox": {
        "type": "object",
        "description": "Khi changed=false chỉ có etag và changed. Khi changed=true có đủ threads, endpoints, messages và more.",
        "additionalProperties": false,
        "required": [
          "etag",
          "changed"
        ],
        "properties": {
          "etag": {
            "$ref": "#/components/schemas/Digest"
          },
          "changed": {
            "type": "boolean"
          },
          "threads": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MsgThread"
            }
          },
          "endpoints": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MsgEndpoint"
            }
          },
          "messages": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/MsgInboxMessage"
            }
          },
          "more": {
            "type": "boolean"
          }
        }
      },
      "MsgAck": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "endpoint_id",
          "message_ids"
        ],
        "properties": {
          "endpoint_id": {
            "type": "string",
            "pattern": "^mep_[A-Za-z0-9_-]{6,64}$"
          },
          "message_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "string",
              "pattern": "^msg_[A-Za-z0-9_-]{6,64}$"
            }
          }
        }
      },
      "MsgAcked": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "acked"
        ],
        "properties": {
          "acked": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "MsgRead": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "through_seq",
          "share"
        ],
        "properties": {
          "through_seq": {
            "type": "integer",
            "minimum": 1
          },
          "share": {
            "type": "boolean",
            "description": "true: cho người kia thấy mốc đã đọc này."
          }
        }
      },
      "MsgReportCreate": {
        "type": "object",
        "description": "Không có trường chữ tự do: báo cáo không kèm nội dung.",
        "additionalProperties": false,
        "required": [
          "thread_id",
          "reason"
        ],
        "properties": {
          "thread_id": {
            "type": "string",
            "pattern": "^th_[A-Za-z0-9_-]{6,64}$"
          },
          "reason": {
            "enum": [
              "SPAM",
              "HARASSMENT",
              "OTHER"
            ]
          },
          "message_id": {
            "type": "string",
            "pattern": "^msg_[A-Za-z0-9_-]{6,64}$"
          }
        }
      },
      "MsgReportCreated": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "report_id"
        ],
        "properties": {
          "report_id": {
            "type": "string",
            "pattern": "^rp_[A-Za-z0-9_-]{6,64}$"
          }
        }
      },
      "MsgOpsReports": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reports",
          "reported"
        ],
        "properties": {
          "reports": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "report_id",
                "reporter",
                "reported",
                "thread_id",
                "message_id",
                "reason",
                "at"
              ],
              "properties": {
                "report_id": {
                  "type": "string",
                  "pattern": "^rp_[A-Za-z0-9_-]{6,64}$"
                },
                "reporter": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:@-]{1,128}$"
                },
                "reported": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:@-]{1,128}$"
                },
                "thread_id": {
                  "type": "string",
                  "pattern": "^th_[A-Za-z0-9_-]{6,64}$"
                },
                "message_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reason": {
                  "enum": [
                    "SPAM",
                    "HARASSMENT",
                    "OTHER"
                  ]
                },
                "at": {
                  "$ref": "#/components/schemas/UtcTime"
                }
              }
            }
          },
          "reported": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "user_id",
                "count",
                "grant_id"
              ],
              "properties": {
                "user_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:@-]{1,128}$"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                },
                "grant_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
