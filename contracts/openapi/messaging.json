  "paths": {
    "/v1/messages/people": {
      "get": {
        "operationId": "listMessagePeople",
        "description": "Những thành viên cùng workspace mà người gọi có thể mời nhắn tin: còn quyền messaging.use, còn đồng ý messaging, có ít nhất một điểm nhận tin, không chặn hai chiều (LNH-T33). Danh bạ duy nhất là thành viên của workspace.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Workspace"
          }
        ],
        "responses": {
          "200": {
            "description": "Danh sách",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MsgPeople"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/messages/endpoints": {
      "get": {
        "operationId": "listMessageEndpoints",
        "description": "«Thiết bị của tôi» (LNH-T30): các điểm nhận tin của chính người gọi, đang dùng và đã gỡ trong 30 ngày. Máy chủ không lưu tên máy hay user agent; loại máy do người dùng chọn.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Workspace"
          }
        ],
        "responses": {
          "200": {
            "description": "Thiết bị của tôi",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MsgEndpointList"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "registerMessageEndpoint",
        "description": "Đăng ký trình duyệt này làm một điểm nhận tin với khóa công khai P-256 của nó. Cần đăng nhập mới trong 300 giây (401 REAUTH_REQUIRED). Tối đa 5 điểm đang dùng (422 ENDPOINT_LIMIT). Đăng ký lại đúng khóa đang dùng của mình trả 200 với điểm đã có; khóa đã gỡ hoặc của người khác trả 409.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Workspace"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MsgEndpointCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Điểm nhận tin đã có với đúng khóa này",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MsgEndpoint"
                }
              }
            }
          },
          "201": {
            "description": "Đã đăng ký",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MsgEndpoint"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/messages/endpoints/{endpoint_id}/revoke": {
      "post": {
        "operationId": "revokeMessageEndpoint",
        "description": "Gỡ một thiết bị của chính mình: các phong bì đang chờ của nó bị xóa, việc gỡ được ghi vào sổ thu hồi độc lập. Gỡ lần hai trả lại đúng trạng thái đã gỡ.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Workspace"
          },
          {
            "$ref": "#/components/parameters/MsgEndpointId"
