    "/v1/messages/inbox": {
      "get": {
        "operationId": "getMessageInbox",
        "description": "Hộp thư của một điểm nhận tin: các hội thoại của người gọi, các thiết bị của họ và tối đa 50 tin còn chờ thiết bị này, cũ trước. Thăm dò bằng GET thường (LNH-T35): gửi lại etag lần trước; không có gì đổi thì chỉ nhận {etag, changed:false}. Đọc hộp thư không đổi gì ở máy chủ; phong bì chỉ bị xóa khi thiết bị xác nhận đã lưu (ack).",
        "parameters": [
          {
            "$ref": "#/components/parameters/Workspace"
          },
          {
            "name": "endpoint",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^mep_[A-Za-z0-9_-]{6,64}$"
            }
          },
          {
            "name": "etag",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Digest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Hộp thư",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MsgInbox"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
