    "/v1/messages/threads/{thread_id}/messages": {
      "post": {
        "operationId": "sendMessage",
        "description": "Gửi một tin đã mã hóa đầu cuối (LNH-MSG-1). Máy chủ chỉ nhận bản mã. Không phải một kế hoạch: không gì ngoài LeNhip thay đổi (LNH-T34). 409 DUPLICATE_MESSAGE (kèm resource_id) khi client_ref này của thiết bị đã được lưu; 409 KEYS_CHANGED khi tập khóa đã đổi, không lưu gì; 409 RECIPIENT_UNAVAILABLE khi không gửi được tới người kia; 429 kèm Retry-After khi quá 30 tin một phút hoặc 500 tin một ngày. Phản hồi chỉ có mã và thời điểm.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Workspace"
          },
          {
            "$ref": "#/components/parameters/MsgThreadId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MsgSend"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Máy chủ đã nhận",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MsgSent"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
